{
  "name": "biofit",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:mobile": "npm run start -w @biofit/mobile",
    "build:shared": "npm run build -w @biofit/shared",
    "build:treino": "npm run build -w @biofit/shared && npm run build -w @biofit/treino",
    "build": "npm run build -w @biofit/shared && npm run build -w @biofit/treino"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  },
  "overrides": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "allowScripts": {
    "esbuild@0.28.1": true
  }
}
