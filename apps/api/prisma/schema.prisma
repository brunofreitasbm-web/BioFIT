// Local dev uses SQLite for zero-infra setup (no Docker/Postgres available in this environment).
// To move to Postgres: change provider to "postgresql" and set DATABASE_URL accordingly —
// the schema below avoids native enums so the switch is a one-line change.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id          String   @id @default(cuid())
  nome        String
  email       String   @unique
  senhaHash   String
  role        String // "PERSONAL" | "ALUNO"
  objetivo    String? // apenas para role === "ALUNO": EMAGRECIMENTO | HIPERTROFIA | FORCA | RECUPERACAO_POS_LESAO
  createdAt   DateTime @default(now())

  // Branding do Personal
  brandColor  String?  @default("#4f7cff")
  brandAccent String?  @default("#a6ff3f")
  brandName   String?

  // Gamificação do Aluno
  xp          Int      @default(0)
  streak      Int      @default(0)
  ultimoTreinoEm DateTime?

  // Only set when role === "ALUNO": which personal trainer owns this student
  personalId  String?
  personal    User?    @relation("PersonalAlunos", fields: [personalId], references: [id])
  alunos      User[]   @relation("PersonalAlunos")

  exercicios       Exercicio[]     @relation("PersonalExercicios")
  fichasCriadas    Ficha[]         @relation("PersonalFichas")
  fichasRecebidas  Ficha[]         @relation("AlunoFichas")
  execucoes        ExecucaoSerie[] @relation("AlunoExecucoes")
  desafiosCriados  Desafio[]       @relation("PersonalDesafios")
  participacoes    DesafioParticipante[]
  cobrancasCriadas Cobranca[]      @relation("PersonalCobrancas")
  cobrancasRecebidas Cobranca[]    @relation("AlunoCobrancas")
}

model Exercicio {
  id            String   @id @default(cuid())
  nome          String
  grupoMuscular String
  midiaUrl      String?
  videoUrl      String?
  descricao     String?
  createdAt     DateTime @default(now())

  personalId String
  personal   User   @relation("PersonalExercicios", fields: [personalId], references: [id])

  blocoItens BlocoItem[]
}

model Desafio {
  id         String    @id @default(cuid())
  titulo     String
  inicio     DateTime
  fim        DateTime
  createdAt  DateTime  @default(now())

  personalId String
  personal   User      @relation("PersonalDesafios", fields: [personalId], references: [id])

  participantes DesafioParticipante[]
}

model DesafioParticipante {
  id        String @id @default(cuid())

  desafioId String
  desafio   Desafio @relation(fields: [desafioId], references: [id], onDelete: Cascade)

  alunoId String
  aluno   User   @relation(fields: [alunoId], references: [id])

  @@unique([desafioId, alunoId])
}

model Cobranca {
  id              String   @id @default(cuid())
  valorCentavos   Int
  status          String   @default("PENDENTE") // PENDENTE | PAGO | VENCIDO
  descricao       String?
  pixQrCodeBase64 String?
  pixCopiaCola    String?
  mpPaymentId     String?
  createdAt       DateTime @default(now())
  pagoEm          DateTime?

  personalId String
  personal   User   @relation("PersonalCobrancas", fields: [personalId], references: [id])

  alunoId String
  aluno   User   @relation("AlunoCobrancas", fields: [alunoId], references: [id])
}

model Ficha {
  id        String   @id @default(cuid())
  titulo    String
  semana    Int
  ativa     Boolean  @default(true)
  createdAt DateTime @default(now())

  personalId String
  personal   User   @relation("PersonalFichas", fields: [personalId], references: [id])

  alunoId String
  aluno   User   @relation("AlunoFichas", fields: [alunoId], references: [id])

  blocos BlocoTreino[]

  @@index([alunoId, ativa])
}

model BlocoTreino {
  id                String @id @default(cuid())
  tipo              String // AQUECIMENTO | SIMPLES | BI_SET | TRI_SET | CIRCUITO
  nome              String?
  ordem             Int
  rounds            Int
  descansoSegundos  Int

  fichaId String
  ficha   Ficha  @relation(fields: [fichaId], references: [id], onDelete: Cascade)

  itens BlocoItem[]
}

model BlocoItem {
  id              String  @id @default(cuid())
  ordem           Int
  repeticoesAlvo  String
  cargaKg         Float?

  blocoId String
  bloco   BlocoTreino @relation(fields: [blocoId], references: [id], onDelete: Cascade)

  exercicioId String
  exercicio   Exercicio @relation(fields: [exercicioId], references: [id])

  execucoes ExecucaoSerie[]
}

model ExecucaoSerie {
  id           String   @id @default(cuid())
  rodada       Int
  cargaKg      Float
  repeticoes   Int
  rpe          Float?
  executadoEm  DateTime @default(now())

  blocoItemId String
  blocoItem   BlocoItem @relation(fields: [blocoItemId], references: [id], onDelete: Cascade)

  alunoId String
  aluno   User   @relation("AlunoExecucoes", fields: [alunoId], references: [id])
}
